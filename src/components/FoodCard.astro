---
import type { CollectionEntry } from 'astro:content';

interface Props {
  review: CollectionEntry<'reviews'>;
}

const { review } = Astro.props;
const { data, slug } = review;

const formattedDate = new Intl.DateTimeFormat('th-TH', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(data.pubDate);

// Combine keywords for client-side search
const searchKeywords = [
  data.title,
  data.shopName,
  data.category,
  ...data.tags,
  ...data.recommendedMenus,
  data.description
].join(' ').toLowerCase();
---

<article
  data-food-card
  data-searchable-card
  data-category="food"
  data-open-hours={data.openingHours}
  data-keywords={searchKeywords}
  class="bg-white dark:bg-stone-900 rounded-3xl border border-stone-200 dark:border-stone-800 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col group relative"
>
  <!-- Card Cover -->
  <div class="relative aspect-[16/10] overflow-hidden bg-stone-100 dark:bg-stone-800 block">
    <a href={`/reviews/${slug}`} class="block w-full h-full">
      <img
        src={data.coverImage}
        alt={`รูปภาพหน้าร้านและเมนูอาหาร ${data.shopName} ย่านอ่าวอุดม - ${data.title}`}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </a>

    <!-- Category Pill -->
    <div class="absolute top-3 left-3 bg-white/95 dark:bg-stone-900/95 backdrop-blur-sm text-stone-800 dark:text-stone-100 text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm flex items-center gap-1">
      <span>{data.category}</span>
    </div>

    <!-- Heart Bookmark Button -->
    <button
      type="button"
      data-fav-toggle-btn
      data-item-id={slug}
      data-item-title={data.shopName || data.title}
      data-item-category={data.category}
      data-item-image={data.coverImage}
      data-item-price={data.priceRange}
      data-item-url={`/reviews/${slug}`}
      data-item-maps={data.googleMapsUrl}
      class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 dark:bg-stone-900/90 backdrop-blur-sm flex items-center justify-center text-stone-400 hover:text-rose-500 shadow-sm transition-all hover:scale-110 active:scale-95 cursor-pointer z-10"
      title="บันทึกเป็นร้านโปรด"
      aria-label="บันทึกเป็นร้านโปรด"
    >
      <svg class="w-4 h-4 fill-current transition-colors" viewBox="0 0 24 24">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
    </button>

    <!-- Rating badge & Live Open Now badge -->
    <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between pointer-events-none">
      <div data-open-badge class="hidden text-[10px] font-extrabold px-2 py-0.5 rounded-full shadow-sm"></div>
      <div class="ml-auto bg-stone-900/80 backdrop-blur-sm text-amber-300 text-xs font-bold px-2.5 py-1 rounded-full flex items-center gap-1 shadow-sm">
        ⭐ <span>{data.rating.toFixed(1)}</span>
      </div>
    </div>
  </div>

  <!-- Content -->
  <div class="p-5 flex flex-col flex-grow">
    <div class="flex items-center gap-2 text-xs text-stone-400 dark:text-stone-500 mb-2">
      <span>{formattedDate}</span>
      <span>•</span>
      <span>{data.author}</span>
    </div>

    <h3 class="font-bold text-stone-900 dark:text-white text-lg leading-snug mb-2 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-2">
      <a href={`/reviews/${slug}`}>
        {data.title}
      </a>
    </h3>

    <p class="text-sm text-stone-600 dark:text-stone-300 line-clamp-2 mb-4 flex-grow">
      {data.description}
    </p>

    <!-- Info Meta badges -->
    <div class="pt-3 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between text-xs text-stone-500 dark:text-stone-400">
      <span class="flex items-center gap-1 font-semibold text-stone-700 dark:text-stone-300">
        💵 <span>{data.priceRange}</span>
      </span>
      <span class="flex items-center gap-1">
        ⏰ <span>{data.openingHours.split('(')[0]}</span>
      </span>
    </div>
  </div>
</article>
