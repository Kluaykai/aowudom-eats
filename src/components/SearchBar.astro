---
// SearchBar.astro - Client-side instant filter without heavy libraries
---

<div class="relative w-full max-w-xl mx-auto my-6" id="search-container">
  <div class="relative flex items-center">
    <span class="absolute left-4 text-stone-400 text-lg pointer-events-none">🔍</span>
    <input
      type="text"
      id="search-input"
      placeholder="ค้นหาชื่อร้าน, เมนู, หมวดหมู่ เช่น หมูกรอบ, ปิดดึก, กาแฟ..."
      class="w-full bg-white border border-stone-200 rounded-2xl pl-12 pr-10 py-3.5 text-sm md:text-base text-stone-800 placeholder-stone-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all"
    />
    <button
      id="clear-search"
      class="hidden absolute right-4 text-stone-400 hover:text-stone-600 text-sm font-semibold p-1"
      aria-label="ล้างการค้นหา"
    >
      ✕
    </button>
  </div>
  <p id="search-status" class="hidden text-xs text-stone-500 mt-2 px-2"></p>
</div>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-search');
  const searchStatus = document.getElementById('search-status');
  const foodCards = document.querySelectorAll<HTMLElement>('[data-food-card]');

  if (searchInput && foodCards.length > 0) {
    searchInput.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.trim().toLowerCase();
      let matchCount = 0;

      if (term.length > 0) {
        clearBtn?.classList.remove('hidden');
      } else {
        clearBtn?.classList.add('hidden');
      }

      foodCards.forEach((card) => {
        const keywords = card.getAttribute('data-keywords')?.toLowerCase() || '';
        if (keywords.includes(term)) {
          card.style.display = '';
          matchCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (searchStatus) {
        if (term.length > 0) {
          searchStatus.classList.remove('hidden');
          searchStatus.textContent = `พบ ${matchCount} ร้านที่ตรงกับ "${term}"`;
        } else {
          searchStatus.classList.add('hidden');
        }
      }
    });

    clearBtn?.addEventListener('click', () => {
      searchInput.value = '';
      clearBtn.classList.add('hidden');
      if (searchStatus) searchStatus.classList.add('hidden');
      foodCards.forEach((card) => {
        card.style.display = '';
      });
      searchInput.focus();
    });
  }
</script>
