---
// SosModal.astro - หน้าต่างเบอร์ฉุกเฉินเด็กหอ 24 ชม. (SOS Hub)
---

<div
  id="sos-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-stone-900/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="sos-title"
>
  <div
    class="relative w-full max-w-lg bg-white dark:bg-stone-900 rounded-3xl shadow-2xl border border-stone-200 dark:border-stone-800 overflow-hidden transform scale-95 transition-transform duration-300 max-h-[90vh] flex flex-col"
    id="sos-modal-container"
  >
    <!-- Header -->
    <div class="px-5 py-4 border-b border-red-100 dark:border-red-950/50 bg-red-50/80 dark:bg-red-950/30 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="w-9 h-9 rounded-xl bg-red-600 text-white flex items-center justify-center text-lg font-bold shadow-xs animate-pulse">
          🚨
        </span>
        <div>
          <h3 id="sos-title" class="font-extrabold text-base sm:text-lg text-red-950 dark:text-red-200 leading-tight">
            เบอร์โทรฉุกเฉินเด็กหอ 24 ชม.
          </h3>
          <p class="text-[11px] text-red-700/80 dark:text-red-300/80">
            แตะที่เบอร์เพื่อโทรออกทันที (พื้นที่ ม.เกษตร ศรีราชา & อ่าวอุดม)
          </p>
        </div>
      </div>
      <button
        id="close-sos-btn"
        class="w-8 h-8 rounded-full flex items-center justify-center text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors cursor-pointer text-lg"
        aria-label="ปิดหน้าต่าง"
      >
        ✕
      </button>
    </div>

    <!-- Body -->
    <div class="p-4 sm:p-5 overflow-y-auto flex-grow space-y-3">
      <!-- High Priority: Bike Emergency -->
      <div class="bg-red-50 dark:bg-red-950/40 rounded-2xl p-4 border border-red-200 dark:border-red-900/60">
        <span class="text-[11px] font-extrabold text-red-600 dark:text-red-400 uppercase tracking-wider block mb-1">
          🛵 ยางแบน / รถดับ / สตาร์ทไม่ติด 24 ชม.
        </span>
        <div class="space-y-2 mt-2">
          <div class="flex items-center justify-between bg-white dark:bg-stone-800 p-2.5 rounded-xl border border-red-100 dark:border-stone-700">
            <div>
              <span class="font-bold text-stone-900 dark:text-white text-xs block">ช่างโจ้ ปะยางนอกสถานที่ 24 ชม.</span>
              <span class="text-[11px] text-stone-500">บริการถึงที่ ม.เกษตร ประตู 1-3 และซอยอ่าวอุดม</span>
            </div>
            <a
              href="tel:0933242443"
              class="px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs flex items-center gap-1 shadow-xs transition-colors"
            >
              📞 093-324-2443
            </a>
          </div>

          <div class="flex items-center justify-between bg-white dark:bg-stone-800 p-2.5 rounded-xl border border-red-100 dark:border-stone-700">
            <div>
              <span class="font-bold text-stone-900 dark:text-white text-xs block">ช่างอ๊อฟ ซ่อมมอไซค์ถึงที่</span>
              <span class="text-[11px] text-stone-500">พ่วงแบต เปลี่ยนยาง รถดับกลางทาง</span>
            </div>
            <a
              href="tel:0640256757"
              class="px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs flex items-center gap-1 shadow-xs transition-colors"
            >
              📞 064-025-6757
            </a>
          </div>
        </div>
      </div>

      <!-- Medical & Rescue -->
      <div class="bg-stone-50 dark:bg-stone-800/60 rounded-2xl p-4 border border-stone-200 dark:border-stone-700">
        <span class="text-[11px] font-extrabold text-stone-700 dark:text-stone-300 uppercase tracking-wider block mb-2">
          🚑 เจ็บป่วยฉุกเฉิน / อุบัติเหตุ / กู้ภัย
        </span>
        <div class="space-y-2">
          <div class="flex items-center justify-between bg-white dark:bg-stone-800 p-2.5 rounded-xl border border-stone-200 dark:border-stone-700">
            <div>
              <span class="font-bold text-stone-900 dark:text-white text-xs block">หน่วยกู้ภัยสว่างประทีป ศรีราชา</span>
              <span class="text-[11px] text-stone-500">เหตุฉุกเฉิน 24 ชั่วโมง รวดเร็วในพื้นที่</span>
            </div>
            <a
              href="tel:038311151"
              class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-stone-900 font-bold text-xs flex items-center gap-1 transition-colors"
            >
              📞 038-311-151
            </a>
          </div>

          <div class="flex items-center justify-between bg-white dark:bg-stone-800 p-2.5 rounded-xl border border-stone-200 dark:border-stone-700">
            <div>
              <span class="font-bold text-stone-900 dark:text-white text-xs block">โรงพยาบาลแหลมฉบัง</span>
              <span class="text-[11px] text-stone-500">ห้องฉุกเฉิน ER ใกล้ ม.เกษตร ศรีราชา</span>
            </div>
            <a
              href="tel:038490555"
              class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center gap-1 transition-colors"
            >
              📞 038-490-555
            </a>
          </div>

          <div class="flex items-center justify-between bg-white dark:bg-stone-800 p-2.5 rounded-xl border border-stone-200 dark:border-stone-700">
            <div>
              <span class="font-bold text-stone-900 dark:text-white text-xs block">ศูนย์กู้ชีพนเรนทร (แห่งชาติ)</span>
              <span class="text-[11px] text-stone-500">แจ้งเหตุเจ็บป่วยวิกฤตทั่วไทย</span>
            </div>
            <a
              href="tel:1669"
              class="px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs flex items-center gap-1 transition-colors"
            >
              📞 1669
            </a>
          </div>
        </div>
      </div>

      <!-- Campus & Security -->
      <div class="bg-stone-50 dark:bg-stone-800/60 rounded-2xl p-4 border border-stone-200 dark:border-stone-700">
        <span class="text-[11px] font-extrabold text-stone-700 dark:text-stone-300 uppercase tracking-wider block mb-2">
          👮 รปภ. มหาลัย & ตำรวจ
        </span>
        <div class="space-y-2">
          <div class="flex items-center justify-between bg-white dark:bg-stone-800 p-2.5 rounded-xl border border-stone-200 dark:border-stone-700">
            <div>
              <span class="font-bold text-stone-900 dark:text-white text-xs block">ศูนย์ รปภ. ม.เกษตร ศรีราชา</span>
              <span class="text-[11px] text-stone-500">เหตุในรั้วมหาลัยและรอบประตู 1-3</span>
            </div>
            <a
              href="tel:038354580"
              class="px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs flex items-center gap-1 transition-colors"
            >
              📞 038-354-580
            </a>
          </div>

          <div class="flex items-center justify-between bg-white dark:bg-stone-800 p-2.5 rounded-xl border border-stone-200 dark:border-stone-700">
            <div>
              <span class="font-bold text-stone-900 dark:text-white text-xs block">สภ.แหลมฉบัง</span>
              <span class="text-[11px] text-stone-500">เหตุทะเลาะวิวาท ของหาย แจ้งความ</span>
            </div>
            <a
              href="tel:038490482"
              class="px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-900 text-white font-bold text-xs flex items-center gap-1 transition-colors"
            >
              📞 038-490-482
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const sosModal = document.getElementById('sos-modal');
  const sosContainer = document.getElementById('sos-modal-container');
  const closeSosBtn = document.getElementById('close-sos-btn');

  window.openSosModal = function () {
    if (sosModal && sosContainer) {
      sosModal.classList.remove('opacity-0', 'pointer-events-none');
      sosContainer.classList.remove('scale-95');
      sosContainer.classList.add('scale-100');
    }
  };

  window.closeSosModal = function () {
    if (sosModal && sosContainer) {
      sosModal.classList.add('opacity-0', 'pointer-events-none');
      sosContainer.classList.remove('scale-100');
      sosContainer.classList.add('scale-95');
    }
  };

  if (closeSosBtn) closeSosBtn.addEventListener('click', window.closeSosModal);
  if (sosModal) {
    sosModal.addEventListener('click', (e) => {
      if (e.target === sosModal) window.closeSosModal();
    });
  }

  document.addEventListener('click', (e) => {
    if (e.target.closest('[data-open-sos]')) {
      window.openSosModal();
    }
  });
</script>
