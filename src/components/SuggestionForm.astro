---
// SuggestionForm.astro - ฟอร์มแนะนำร้านเด็ด/แจ้งอัปเดตข้อมูลย่านอ่าวอุดม
---

<div class="bg-gradient-to-br from-amber-50 via-orange-50 to-white rounded-3xl border border-orange-200/80 p-6 md:p-10 shadow-sm relative overflow-hidden" id="suggestion-form-container">
  <div class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-8">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white border border-brand-200 text-brand-600 text-xs font-bold mb-3 shadow-2xs">
        💡 ร่วมสร้าง Community เด็กหอ ม.เกษตร ศรีราชา
      </span>
      <h2 class="text-2xl md:text-3xl font-extrabold text-stone-900 tracking-tight">
        แนะนำร้านเด็ด / หอพัก / แจ้งข้อมูลอัปเดต 💬
      </h2>
      <p class="text-stone-600 text-xs md:text-sm mt-2 leading-relaxed">
        เจอร้านเปิดใหม่ เมนูลับที่อยากบอกต่อ หรือร้านไหนย้ายพิกัด แจ้งมาได้เลย! ทีมงานจะนำข้อมูลไปตรวจสอบและอัปเดตขึ้นเว็บให้ทันที
      </p>
    </div>

    <!-- Form -->
    <form id="suggest-form" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Name of submitter -->
        <div>
          <label for="s-author" class="block text-xs font-bold text-stone-700 mb-1">
            ชื่อของคุณ / นามแฝง <span class="text-stone-400 font-normal">(เช่น นิสิตวิศวะฯ ปี 2)</span>
          </label>
          <input
            type="text"
            id="s-author"
            required
            placeholder="เช่น เด็กหอประตู 3, นิสิต KU"
            class="w-full bg-white border border-stone-200 rounded-xl px-3.5 py-2.5 text-sm text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all"
          />
        </div>

        <!-- Category -->
        <div>
          <label for="s-category" class="block text-xs font-bold text-stone-700 mb-1">
            หมวดหมู่ที่แนะนำ <span class="text-red-500">*</span>
          </label>
          <select
            id="s-category"
            required
            class="w-full bg-white border border-stone-200 rounded-xl px-3.5 py-2.5 text-sm text-stone-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all"
          >
            <option value="ร้านอาหาร/คาเฟ่">🍜 ร้านอาหาร / คาเฟ่ / ของหวาน</option>
            <option value="หอพัก/คอนโด">🏢 หอพัก / คอนโดมิเนียม</option>
            <option value="ร้านเหล้า/นั่งชิล">🍻 ร้านเหล้า / แฮงเอาต์นั่งชิล</option>
            <option value="ร้านซ่อมมอเตอร์ไซค์">🛵 ร้านซ่อมมอเตอร์ไซค์ / ปะยาง</option>
            <option value="แจ้งแก้ไขข้อมูลเดิม">⚠️ แจ้งแก้ไขข้อมูลร้าน/หอพักเดิม</option>
          </select>
        </div>
      </div>

      <!-- Place Name -->
      <div>
        <label for="s-place" class="block text-xs font-bold text-stone-700 mb-1">
          ชื่อร้าน / ชื่อหอพัก / บริการ <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="s-place"
          required
          placeholder="เช่น ร้านข้าวมันไก่เจ๊ณี, หอพักศรีราชาเพลส"
          class="w-full bg-white border border-stone-200 rounded-xl px-3.5 py-2.5 text-sm text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all"
        />
      </div>

      <!-- Details -->
      <div>
        <label for="s-details" class="block text-xs font-bold text-stone-700 mb-1">
          รายละเอียด / เมนูแนะนำ / พิกัดคร่าวๆ <span class="text-red-500">*</span>
        </label>
        <textarea
          id="s-details"
          required
          rows="3"
          placeholder="เช่น อยู่ตรงข้ามประตู 3 เยื้องๆ เซเว่น กะเพราหมูกรอบให้เยอะมาก ปิดเที่ยงคืน หรือระบุจุดสังเกต..."
          class="w-full bg-white border border-stone-200 rounded-xl px-3.5 py-2.5 text-sm text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all"
        ></textarea>
      </div>

      <!-- Submit Button -->
      <div class="text-center pt-2">
        <button
          type="submit"
          id="s-submit-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-brand-600 to-orange-500 hover:from-brand-700 hover:to-orange-600 text-white font-bold text-sm px-8 py-3.5 rounded-xl shadow-md hover:shadow-lg transition-all cursor-pointer"
        >
          <span>🚀</span> ส่งข้อมูลแนะนำร้านเด็ด
        </button>
      </div>
    </form>

    <!-- Success Message Box -->
    <div id="suggest-success" class="hidden text-center py-8">
      <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-2xl mx-auto mb-3 shadow-inner">
        ✓
      </div>
      <h3 class="text-lg font-bold text-stone-900">ขอบคุณสำหรับข้อมูลครับ! 🎉</h3>
      <p class="text-xs md:text-sm text-stone-600 mt-1 max-w-md mx-auto">
        ทีมงานได้รับข้อความแนะนำของคุณเรียบร้อยแล้ว จะรีบนำข้อมูลไปเช็คพิกัดและนำขึ้นเว็บไซต์โดยเร็วที่สุดครับ
      </p>
      <button
        type="button"
        id="s-reset-btn"
        class="mt-4 text-xs font-bold text-brand-600 hover:underline cursor-pointer"
      >
        + แนะนำร้านอื่นเพิ่มเติม
      </button>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('suggest-form') as HTMLFormElement | null;
  const successBox = document.getElementById('suggest-success');
  const resetBtn = document.getElementById('s-reset-btn');
  const submitBtn = document.getElementById('s-submit-btn') as HTMLButtonElement | null;
  const WEBHOOK_URL = 'https://script.google.com/macros/s/AKfycbwXgkv8TS9jznex5DUudboLuM2roF8sN6neWL4BgikwCmYHCjcXzFmxEPah6-wUAgWHdg/exec';

  if (form && successBox) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const author = (document.getElementById('s-author') as HTMLInputElement)?.value || '';
      const category = (document.getElementById('s-category') as HTMLSelectElement)?.value || '';
      const place = (document.getElementById('s-place') as HTMLInputElement)?.value || '';
      const details = (document.getElementById('s-details') as HTMLTextAreaElement)?.value || '';

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>⏳</span> กำลังส่งข้อมูล...';
      }

      const payload = {
        author,
        category,
        place,
        details,
        timestamp: new Date().toISOString()
      };

      // ส่งข้อความเข้า LINE ผ่าน Google Apps Script Webhook
      try {
        await fetch(WEBHOOK_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });
      } catch (err) {
        console.error('Failed to send to LINE:', err);
      }

      // บันทึกลง LocalStorage เผื่อเก็บประวัติฝั่ง Client
      try {
        const stored = JSON.parse(localStorage.getItem('ku_user_suggestions') || '[]');
        stored.push(payload);
        localStorage.setItem('ku_user_suggestions', JSON.stringify(stored));
      } catch (err) {
        console.error(err);
      }

      // แสดงกล่องสำเร็จ
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>🚀</span> ส่งข้อมูลแนะนำร้านเด็ด';
      }
      form.classList.add('hidden');
      successBox.classList.remove('hidden');
    });

    resetBtn?.addEventListener('click', () => {
      form.reset();
      form.classList.remove('hidden');
      successBox.classList.add('hidden');
    });
  }
</script>
