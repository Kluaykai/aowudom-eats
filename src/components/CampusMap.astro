---
// CampusMap.astro - Interactive Map of KU Sriracha & Aow Udom
import { allLocations } from '../data/locationsData';

interface Props {
  heightClass?: string;
  showFilters?: boolean;
}

const { heightClass = "h-[500px] md:h-[600px]", showFilters = true } = Astro.props;
---

<div class="relative w-full rounded-3xl overflow-hidden border border-stone-200 dark:border-stone-800 shadow-lg bg-stone-100 dark:bg-stone-900" id="campus-map-wrapper">
  {showFilters && (
    <!-- Map Control Bar -->
    <div class="absolute top-4 left-4 right-4 z-[400] flex flex-wrap items-center justify-between gap-2 pointer-events-none">
      <!-- Category Pills -->
      <div class="flex flex-wrap gap-1.5 p-1.5 bg-white/95 dark:bg-stone-900/95 backdrop-blur-md rounded-2xl shadow-md border border-stone-200/80 dark:border-stone-700/80 pointer-events-auto max-w-full overflow-x-auto">
        <button
          type="button"
          data-map-filter="all"
          class="map-filter-btn active text-xs font-bold px-3 py-1.5 rounded-xl bg-brand-500 text-white shadow-xs transition-all"
        >
          ทั้งหมด ({allLocations.length})
        </button>
        <button
          type="button"
          data-map-filter="food"
          class="map-filter-btn text-xs font-semibold px-3 py-1.5 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-all"
        >
          🍜 ของกิน
        </button>
        <button
          type="button"
          data-map-filter="dorm"
          class="map-filter-btn text-xs font-semibold px-3 py-1.5 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-all"
        >
          🏢 หอพัก/คอนโด
        </button>
        <button
          type="button"
          data-map-filter="nightlife"
          class="map-filter-btn text-xs font-semibold px-3 py-1.5 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-all"
        >
          🍻 ร้านเหล้า
        </button>
        <button
          type="button"
          data-map-filter="motorbike"
          class="map-filter-btn text-xs font-semibold px-3 py-1.5 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-all"
        >
          🛵 ปะยาง/ซ่อมรถ
        </button>
        <button
          type="button"
          data-map-filter="landmark"
          class="map-filter-btn text-xs font-semibold px-3 py-1.5 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-all"
        >
          🏫 จุดสำคัญ
        </button>
      </div>

      <!-- Locate Me & Reset View -->
      <div class="flex items-center gap-2 pointer-events-auto">
        <button
          id="locate-user-btn"
          type="button"
          class="px-3.5 py-2 bg-white dark:bg-stone-900 text-stone-800 dark:text-white rounded-2xl shadow-md border border-stone-200 dark:border-stone-700 text-xs font-bold flex items-center gap-1.5 hover:bg-stone-50 dark:hover:bg-stone-800 transition-all cursor-pointer"
          title="ค้นหาตำแหน่งของฉัน"
        >
          <span>📍 ตำแหน่งฉัน</span>
        </button>
        <button
          id="reset-map-btn"
          type="button"
          class="px-3 py-2 bg-white dark:bg-stone-900 text-stone-600 dark:text-stone-300 rounded-2xl shadow-md border border-stone-200 dark:border-stone-700 text-xs font-bold hover:bg-stone-50 dark:hover:bg-stone-800 transition-all cursor-pointer"
          title="จัดมุมมองตรงกลาง ม.เกษตร"
        >
          🎯 ม.เกษตร
        </button>
      </div>
    </div>
  )}

  <!-- Leaflet Map Container -->
  <div id="leaflet-map" class={`w-full ${heightClass} z-10`}></div>

  <!-- Legend at Bottom Right -->
  <div class="absolute bottom-4 left-4 z-[400] hidden sm:flex items-center gap-2 p-2 bg-white/95 dark:bg-stone-900/95 backdrop-blur-md rounded-xl shadow-md border border-stone-200/80 dark:border-stone-700/80 text-[11px] text-stone-600 dark:text-stone-300">
    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-orange-500 inline-block"></span> ร้านอาหาร</span>
    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-blue-500 inline-block"></span> หอพัก</span>
    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-purple-500 inline-block"></span> ร้านนั่งชิล</span>
    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span> ซ่อมมอไซค์</span>
    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span> จุดสำคัญ</span>
  </div>
</div>

<!-- Load Leaflet Assets -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>
<script
  is:inline
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""
></script>

<style is:inline>
  /* Custom popup styling */
  .leaflet-popup-content-wrapper {
    padding: 0;
    overflow: hidden;
    border-radius: 1.25rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }
  .leaflet-popup-content {
    margin: 0;
    line-height: 1.4;
  }
  .custom-map-marker {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
    border: 2px solid white;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .custom-map-marker:hover {
    transform: scale(1.15) translateY(-2px);
    z-index: 1000 !important;
  }
</style>

<script is:inline define:vars={{ allLocations }}>
  window.mapLocations = allLocations;

  function initMap() {
    if (typeof L === 'undefined') {
      setTimeout(initMap, 100);
      return;
    }

    const mapElement = document.getElementById('leaflet-map');
    if (!mapElement) return;

    // Center on KU Sriracha (13.1215, 100.9189)
    const initialCoords = [13.1215, 100.9189];
    const map = L.map('leaflet-map', {
      zoomControl: false,
    }).setView(initialCoords, 14);

    // Zoom control at bottom right
    L.control.zoom({ position: 'bottomright' }).addTo(map);

    // OSM CartoDB Voyager tiles (clean, modern map tiles)
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    // Marker categories config
    const typeConfig = {
      food: { color: '#f97316', emoji: '🍜', label: 'ร้านอาหาร' },
      dorm: { color: '#3b82f6', emoji: '🏢', label: 'หอพัก/คอนโด' },
      nightlife: { color: '#a855f7', emoji: '🍻', label: 'ร้านนั่งชิล' },
      motorbike: { color: '#ef4444', emoji: '🛵', label: 'ซ่อมมอไซค์' },
      landmark: { color: '#10b981', emoji: '🏫', label: 'จุดสำคัญ' },
    };

    const markers = [];

    // Helper to create HTML pin
    function createCustomIcon(type) {
      const cfg = typeConfig[type] || { color: '#f97316', emoji: '📍' };
      return L.divIcon({
        className: 'custom-pin-wrapper',
        html: `
          <div class="custom-map-marker w-9 h-9" style="background-color: ${cfg.color};">
            <span class="text-base select-none">${cfg.emoji}</span>
          </div>
        `,
        iconSize: [36, 36],
        iconAnchor: [18, 18],
        popupAnchor: [0, -18],
      });
    }

    // Add all markers
    window.mapLocations.forEach((loc) => {
      const icon = createCustomIcon(loc.type);
      const marker = L.marker([loc.lat, loc.lng], { icon });

      // Popup Content Card
      const popupHtml = `
        <div class="w-64 sm:w-72 bg-white font-['Prompt'] text-stone-800">
          <div class="relative aspect-[16/9] w-full overflow-hidden bg-stone-100">
            <img src="${loc.coverImage}" alt="${loc.title}" class="w-full h-full object-cover" />
            <div class="absolute top-2 left-2 bg-stone-900/80 backdrop-blur-xs text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
              ${loc.category}
            </div>
            ${loc.rating ? `<div class="absolute bottom-2 right-2 bg-stone-900/80 backdrop-blur-xs text-amber-300 text-[11px] font-bold px-2 py-0.5 rounded-full">⭐ ${loc.rating.toFixed(1)}</div>` : ''}
          </div>
          <div class="p-3.5">
            <div class="text-[10px] text-stone-400 font-semibold mb-1">📍 ${loc.zone}</div>
            <h4 class="font-extrabold text-stone-900 text-sm leading-tight mb-1">${loc.title}</h4>
            <p class="text-xs text-stone-600 line-clamp-2 mb-2">${loc.description}</p>
            ${loc.price ? `<div class="text-xs text-brand-600 font-bold mb-2">💵 ${loc.price}</div>` : ''}
            ${loc.phoneNumber ? `<div class="text-xs text-emerald-600 font-bold mb-2">📞 <a href="tel:${loc.phoneNumber.split('/')[0].trim().replace(/-/g, '')}" class="underline">${loc.phoneNumber}</a></div>` : ''}
            <div class="flex gap-1.5 pt-2 border-t border-stone-100">
              <a href="${loc.googleMapsUrl || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(loc.title)}`}" target="_blank" rel="noopener noreferrer" class="flex-1 py-1.5 text-center text-xs font-bold rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 transition-colors shadow-2xs">
                🧭 นำทาง
              </a>
              ${loc.url ? `<a href="${loc.url}" class="flex-1 py-1.5 text-center text-xs font-semibold rounded-lg bg-stone-100 text-stone-700 hover:bg-stone-200 transition-colors">รายละเอียด</a>` : ''}
            </div>
          </div>
        </div>
      `;

      marker.bindPopup(popupHtml, { maxWidth: 300 });
      marker.locType = loc.type;
      marker.addTo(map);
      markers.push(marker);
    });

    // Filtering markers
    const filterButtons = document.querySelectorAll('.map-filter-btn');
    function applyMapFilter(filterType) {
      filterButtons.forEach((btn) => {
        if (btn.dataset.mapFilter === filterType) {
          btn.className = 'map-filter-btn active text-xs font-bold px-3 py-1.5 rounded-xl bg-brand-500 text-white shadow-xs transition-all';
        } else {
          btn.className = 'map-filter-btn text-xs font-semibold px-3 py-1.5 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-all';
        }
      });

      markers.forEach((marker) => {
        if (filterType === 'all' || marker.locType === filterType) {
          map.addLayer(marker);
        } else {
          map.removeLayer(marker);
        }
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        applyMapFilter(btn.dataset.mapFilter || 'all');
      });
    });

    // Reset View Button
    const resetBtn = document.getElementById('reset-map-btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        map.flyTo(initialCoords, 14, { duration: 1.2 });
      });
    }

    // Geolocation / Locate user
    let userMarker = null;
    const locateBtn = document.getElementById('locate-user-btn');
    if (locateBtn) {
      locateBtn.addEventListener('click', () => {
        locateBtn.innerHTML = '<span>⏳ กำลังหา...</span>';
        if (!navigator.geolocation) {
          alert('เบราว์เซอร์ไม่รองรับ Geolocation');
          locateBtn.innerHTML = '<span>📍 ตำแหน่งฉัน</span>';
          return;
        }

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const userLat = pos.coords.latitude;
            const userLng = pos.coords.longitude;

            if (userMarker) map.removeLayer(userMarker);

            const userIcon = L.divIcon({
              className: 'user-pin-pulse',
              html: `
                <div class="relative w-6 h-6 flex items-center justify-center">
                  <div class="absolute w-6 h-6 rounded-full bg-blue-500 opacity-30 animate-ping"></div>
                  <div class="w-4 h-4 rounded-full bg-blue-600 border-2 border-white shadow-md"></div>
                </div>
              `,
              iconSize: [24, 24],
              iconAnchor: [12, 12],
            });

            userMarker = L.marker([userLat, userLng], { icon: userIcon }).addTo(map);
            userMarker.bindPopup('<b>📍 คุณอยู่ที่นี่</b>').openPopup();

            map.flyTo([userLat, userLng], 15, { duration: 1.2 });
            locateBtn.innerHTML = '<span>✓ พบตำแหน่ง</span>';
            setTimeout(() => {
              locateBtn.innerHTML = '<span>📍 ตำแหน่งฉัน</span>';
            }, 3000);
          },
          (err) => {
            alert('ไม่สามารถระบุพิกัดได้ (กรุณาอนุญาตให้เข้าถึง Location): ' + err.message);
            locateBtn.innerHTML = '<span>📍 ตำแหน่งฉัน</span>';
          },
          { enableHighAccuracy: true, timeout: 8000 }
        );
      });
    }
  }

  // Load and init
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMap);
  } else {
    initMap();
  }
</script>
