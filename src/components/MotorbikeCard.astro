---
import type { CollectionEntry } from 'astro:content';

interface Props {
  bike: CollectionEntry<'motorbikes'>;
}

const { bike } = Astro.props;
const { data, slug } = bike;

const searchKeywords = [
  data.title,
  data.shopName,
  data.zone,
  data.phoneNumber,
  ...data.services,
  'ซ่อมมอเตอร์ไซค์ ปะยาง มอไซค์ น้ำมันเครื่อง แบตเตอรี่',
].join(' ').toLowerCase();
---

<article
  data-searchable-card
  data-keywords={searchKeywords}
  data-category="motorbikes"
  class="bg-white dark:bg-stone-900 rounded-3xl border border-stone-200 dark:border-stone-800 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col group relative"
>
  <div class="relative aspect-[16/10] overflow-hidden bg-stone-100 dark:bg-stone-800 block">
    <a href={`/motorbikes/${slug}`} class="block w-full h-full">
      <img
        src={data.coverImage}
        alt={`ร้านซ่อมมอเตอร์ไซค์ ปะยาง ${data.shopName} ย่านอ่าวอุดม ม.เกษตร ศรีราชา`}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </a>

    <div class="absolute top-3 left-3 flex gap-1.5 flex-wrap">
      {data.emergencyService && (
        <span class="bg-red-600 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-sm flex items-center gap-1">
          🚨 บริการนอกสถานที่/ฉุกเฉิน
        </span>
      )}
    </div>

    <!-- Heart Bookmark Button -->
    <button
      type="button"
      data-fav-toggle-btn
      data-item-id={slug}
      data-item-title={data.shopName}
      data-item-category="ซ่อมมอไซค์"
      data-item-image={data.coverImage}
      data-item-price={data.priceEstimate}
      data-item-url={`/motorbikes/${slug}`}
      data-item-maps={data.googleMapsUrl}
      class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 dark:bg-stone-900/90 backdrop-blur-sm flex items-center justify-center text-stone-400 hover:text-rose-500 shadow-sm transition-all hover:scale-110 active:scale-95 cursor-pointer z-10"
      title="บันทึกร้านนี้"
      aria-label="บันทึกร้านนี้"
    >
      <svg class="w-4 h-4 fill-current transition-colors" viewBox="0 0 24 24">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
    </button>
  </div>

  <div class="p-5 flex flex-col flex-grow">
    <div class="flex items-center gap-2 text-xs text-stone-500 dark:text-stone-400 mb-2 font-medium">
      <span>📍 {data.zone}</span>
      <span>•</span>
      <span>🛵 {data.distanceToKU}</span>
    </div>

    <h3 class="font-bold text-stone-900 dark:text-white text-lg leading-snug mb-2 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors line-clamp-1">
      <a href={`/motorbikes/${slug}`}>
        {data.shopName}
      </a>
    </h3>

    <!-- Phone Call CTA Box -->
    <a
      href={`tel:${data.phoneNumber.split('/')[0].trim().replace(/-/g, '')}`}
      class="bg-emerald-50 dark:bg-emerald-950/40 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 text-xs font-bold px-3 py-2.5 rounded-2xl mb-3 border border-emerald-200 dark:border-emerald-800/60 flex items-center justify-between transition-colors shadow-2xs"
    >
      <span class="flex items-center gap-1.5">
        <span>📞</span> โทรติดต่อด่วน:
      </span>
      <span class="text-sm font-extrabold text-emerald-700 dark:text-emerald-300">{data.phoneNumber}</span>
    </a>

    <!-- Price and Hours -->
    <div class="bg-stone-50 dark:bg-stone-800/60 rounded-2xl p-2.5 mb-3 border border-stone-100 dark:border-stone-700/60 text-xs space-y-1">
      <div class="flex justify-between">
        <span class="text-stone-400 dark:text-stone-400">เวลาทำการ:</span>
        <span class="font-semibold text-stone-700 dark:text-stone-300">{data.openHours}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-stone-400 dark:text-stone-400">ราคาประเมิน:</span>
        <span class="font-semibold text-stone-800 dark:text-stone-200">{data.priceEstimate}</span>
      </div>
    </div>

    <!-- Services list snippet -->
    <div class="flex flex-wrap gap-1 mt-auto">
      {data.services.slice(0, 2).map((s) => (
        <span class="text-[11px] bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 px-2 py-0.5 rounded-lg">
          ✓ {s}
        </span>
      ))}
    </div>
  </div>
</article>
