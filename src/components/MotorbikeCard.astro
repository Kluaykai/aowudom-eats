---
import type { CollectionEntry } from 'astro:content';

interface Props {
  bike: CollectionEntry<'motorbikes'>;
}

const { bike } = Astro.props;
const { data, slug } = bike;

const searchKeywords = [
  data.title,
  data.shopName,
  data.zone,
  data.phoneNumber,
  ...data.services,
  'ซ่อมมอเตอร์ไซค์ ปะยาง มอไซค์ น้ำมันเครื่อง แบตเตอรี่',
].join(' ').toLowerCase();
---

<article
  data-searchable-card
  data-keywords={searchKeywords}
  data-category="motorbikes"
  class="bg-white rounded-2xl border border-stone-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col group"
>
  <a href={`/motorbikes/${slug}`} class="relative aspect-[16/10] overflow-hidden bg-stone-100 block">
    <img
      src={data.coverImage}
      alt={`ร้านซ่อมมอเตอร์ไซค์ ปะยาง ${data.shopName} ย่านอ่าวอุดม ม.เกษตร ศรีราชา`}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute top-3 left-3 flex gap-1.5 flex-wrap">
      {data.emergencyService && (
        <span class="bg-red-600 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-sm flex items-center gap-1">
          🚨 บริการนอกสถานที่/ฉุกเฉิน
        </span>
      )}
    </div>
  </a>

  <div class="p-5 flex flex-col flex-grow">
    <div class="flex items-center gap-2 text-xs text-stone-500 mb-2 font-medium">
      <span>📍 {data.zone}</span>
      <span>•</span>
      <span>🛵 {data.distanceToKU}</span>
    </div>

    <h3 class="font-bold text-stone-900 text-lg leading-snug mb-2 group-hover:text-red-600 transition-colors line-clamp-1">
      <a href={`/motorbikes/${slug}`}>
        {data.shopName}
      </a>
    </h3>

    <!-- Phone Call CTA Box -->
    <a
      href={`tel:${data.phoneNumber.split('/')[0].trim().replace(/-/g, '')}`}
      class="bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-2 rounded-xl mb-3 border border-emerald-200 flex items-center justify-between transition-colors"
    >
      <span class="flex items-center gap-1.5">
        <span>📞</span> โทรติดต่อด่วน:
      </span>
      <span class="text-sm font-extrabold text-emerald-700">{data.phoneNumber}</span>
    </a>

    <!-- Price and Hours -->
    <div class="bg-stone-50 rounded-xl p-2.5 mb-3 border border-stone-100 text-xs space-y-1">
      <div class="flex justify-between">
        <span class="text-stone-400">เวลาทำการ:</span>
        <span class="font-semibold text-stone-700">{data.openHours}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-stone-400">ราคาประเมิน:</span>
        <span class="font-semibold text-stone-800">{data.priceEstimate}</span>
      </div>
    </div>

    <!-- Services list snippet -->
    <div class="flex flex-wrap gap-1 mt-auto">
      {data.services.slice(0, 2).map((s) => (
        <span class="text-[11px] bg-stone-100 text-stone-600 px-2 py-0.5 rounded-md">
          ✓ {s}
        </span>
      ))}
    </div>
  </div>
</article>
