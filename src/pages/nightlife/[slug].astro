---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const bars = await getCollection('nightlife');
  return bars.map((bar) => ({
    params: { slug: bar.slug },
    props: { bar },
  }));
}

interface Props {
  bar: CollectionEntry<'nightlife'>;
}

const { bar } = Astro.props;
const { data } = bar;
const { Content } = await bar.render();

const avgRating = (data.studentReviews.reduce((sum, r) => sum + r.rating, 0) / data.studentReviews.length).toFixed(1);
---

<MainLayout
  title={`${data.title} - ร้านเหล้า นั่งชิล ย่านอ่าวอุดม`}
  description={`รีวิว ${data.title} สไตล์ ${data.style} โซน ${data.zone} งบประมาณ ${data.pricePerPerson} โปรโมชั่น ${data.highlightPromo}`}
  image={data.coverImage}
>
  <article class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-stone-500 mb-6 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-purple-600">หน้าแรก</a>
      <span>/</span>
      <a href="/nightlife" class="hover:text-purple-600">ร้านเหล้า/นั่งชิล</a>
      <span>/</span>
      <span class="text-stone-700 truncate">{data.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="bg-purple-600 text-white text-xs font-bold px-3 py-1 rounded-full">
          {data.style}
        </span>
        <span class="bg-stone-100 text-stone-700 text-xs font-semibold px-3 py-1 rounded-full">
          📍 โซน: {data.zone}
        </span>
      </div>

      <h1 class="text-2xl md:text-4xl font-extrabold text-stone-900 leading-snug tracking-tight">
        {data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs md:text-sm text-stone-500 mt-3 pb-6 border-b border-stone-200">
        <span>⏰ เวลาทำการ: <strong class="text-stone-800">{data.openHours}</strong></span>
        <span>•</span>
        <span class="text-amber-500 font-bold">⭐ คะแนนรีวิวนิสิต: {avgRating} / 5</span>
      </div>
    </header>

    <!-- Cover Image -->
    <div class="relative rounded-2xl overflow-hidden aspect-[16/9] mb-8 shadow-sm">
      <img
        src={data.coverImage}
        alt={`บรรยากาศร้าน ${data.title} ย่านอ่าวอุดม ม.เกษตร ศรีราชา`}
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Quick Info Box -->
    <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-sm mb-10">
      <!-- Promo Banner -->
      <div class="bg-gradient-to-r from-purple-500 to-indigo-600 text-white p-4 rounded-xl mb-6 shadow-sm flex items-center gap-3">
        <span class="text-2xl">🔥</span>
        <div>
          <span class="text-xs uppercase tracking-wider text-purple-200 font-bold block">ไฮไลท์โปรโมชั่นเด็ด</span>
          <p class="font-bold text-sm md:text-base">{data.highlightPromo}</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="bg-stone-50 p-3.5 rounded-xl border border-stone-100">
          <span class="text-stone-400 text-xs block">งบเฉลี่ยต่อคน</span>
          <span class="text-base font-bold text-purple-600">{data.pricePerPerson}</span>
        </div>
        <div class="bg-stone-50 p-3.5 rounded-xl border border-stone-100">
          <span class="text-stone-400 text-xs block">สไตล์ร้าน</span>
          <span class="text-sm font-semibold text-stone-800">{data.style}</span>
        </div>
        <div class="bg-stone-50 p-3.5 rounded-xl border border-stone-100">
          <span class="text-stone-400 text-xs block">โซนที่ตั้ง</span>
          <span class="text-sm font-semibold text-stone-800">{data.zone}</span>
        </div>
      </div>

      <!-- Facilities List -->
      <h3 class="text-sm font-bold text-stone-800 mb-3">สิ่งอำนวยความสะดวก & บรรยากาศ:</h3>
      <div class="flex flex-wrap gap-2 mb-6">
        {data.facilities.map((f) => (
          <span class="bg-stone-100 text-stone-700 text-xs px-3 py-1.5 rounded-lg flex items-center gap-1">
            <span>✓</span> {f}
          </span>
        ))}
      </div>

      <div class="flex justify-end">
        <a
          href={data.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors shadow-sm"
        >
          <span>📍</span> ดูพิกัดบน Google Maps
        </a>
      </div>
    </div>

    <!-- Article Content -->
    <div class="prose prose-stone lg:prose-lg max-w-none text-stone-700 leading-relaxed font-normal mb-12">
      <Content />
    </div>

    <!-- Student Reviews Section -->
    <section class="mt-12 pt-8 border-t border-stone-200">
      <h2 class="text-xl md:text-2xl font-bold text-stone-900 mb-6 flex items-center gap-2">
        <span>💬</span> รีวิวจริงจากนิสิต ม.เกษตร ศรีราชา ({data.studentReviews.length} รีวิว)
      </h2>

      <div class="space-y-4">
        {data.studentReviews.map((rev) => (
          <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-sm">
            <div class="flex justify-between items-center mb-2">
              <span class="font-bold text-stone-800 text-sm">👤 {rev.author}</span>
              <span class="text-amber-500 font-bold text-xs">⭐ {rev.rating} / 5</span>
            </div>
            <p class="text-stone-600 text-sm leading-relaxed">
              "{rev.comment}"
            </p>
          </div>
        ))}
      </div>
    </section>
  </article>
</MainLayout>
