---
import MainLayout from '../../layouts/MainLayout.astro';
import NightlifeCard from '../../components/NightlifeCard.astro';
import { getCollection } from 'astro:content';

const allNightlife = await getCollection('nightlife');
---

<MainLayout
  title="รวมร้านเหล้า ร้านนั่งชิล ดนตรีสด ย่านอ่าวอุดม ม.เกษตร ศรีราชา"
  description="พิกัดร้านนั่งชิลฟังเพลงสด ร้านเหล้า ผับ บาร์ลับ และรูฟท็อปย่านอ่าวอุดม ม.เกษตร ศรีราชา เช็คโปรโมชั่นเด็ด บรรยากาศ และรีวิวนิสิต"
>
  <div class="max-w-6xl mx-auto px-4 py-10 md:py-14">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-purple-50 text-purple-600 text-xs font-semibold mb-3">
        🍻 ร้านเหล้า & นั่งชิล
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-stone-900 tracking-tight">
        ร้านเหล้า-นั่งชิล <span class="text-purple-600">ย่านอ่าวอุดม</span>
      </h1>
      <p class="mt-3 text-stone-600 text-sm md:text-base">
        รวมจุดแฮงเอาต์ยอดนิยมรอบ ม.เกษตร ศรีราชา ดนตรีสดโฟล์คซอง บาร์ลับค็อกเทล รูฟท็อปวิวทะเล และสายตื๊ดจัดเต็ม
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allNightlife.map((bar) => (
        <NightlifeCard bar={bar} />
      ))}
    </div>
  </div>
</MainLayout>
