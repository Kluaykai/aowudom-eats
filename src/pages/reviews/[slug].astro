---
import MainLayout from '../../layouts/MainLayout.astro';
import ShopSummaryBox from '../../components/ShopSummaryBox.astro';
import FoodCard from '../../components/FoodCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((review) => ({
    params: { slug: review.slug },
    props: { review },
  }));
}

interface Props {
  review: CollectionEntry<'reviews'>;
}

const { review } = Astro.props;
const { data } = review;
const { Content } = await review.render();

const formattedDate = new Intl.DateTimeFormat('th-TH', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(data.pubDate);

// Get related reviews in same category
const allReviews = await getCollection('reviews');
const relatedReviews = allReviews
  .filter(r => r.slug !== review.slug && (r.data.category === data.category || r.data.tags.some(t => data.tags.includes(t))))
  .slice(0, 2);

// JSON-LD Structured Data for Restaurant Review (SEO Boost)
const schema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": data.shopName,
  "image": data.coverImage,
  "servesCuisine": data.category,
  "priceRange": data.priceRange,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": data.rating,
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": "18"
  },
  "review": {
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": data.rating
    },
    "author": {
      "@type": "Person",
      "name": data.author
    },
    "datePublished": data.pubDate.toISOString(),
    "reviewBody": data.description
  }
};
---

<MainLayout
  title={data.title}
  description={data.description}
  image={data.coverImage}
  article={true}
  schema={schema}
>
  <article class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-stone-500 mb-6 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-brand-600">หน้าแรก</a>
      <span>/</span>
      <a href={`/category/${data.category}`} class="hover:text-brand-600">{data.category}</a>
      <span>/</span>
      <span class="text-stone-700 truncate">{data.shopName}</span>
    </nav>

    <!-- Header / Title -->
    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 text-brand-600 text-xs font-semibold mb-4">
        {data.category}
      </div>
      <h1 class="text-2xl md:text-4xl font-extrabold text-stone-900 leading-snug tracking-tight">
        {data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs md:text-sm text-stone-500 mt-4 pb-6 border-b border-stone-200">
        <span class="flex items-center gap-1 font-medium text-stone-700">
          ✍️ <span>{data.author}</span>
        </span>
        <span>•</span>
        <span class="flex items-center gap-1">
          📅 <span>เผยแพร่เมื่อ: {formattedDate}</span>
        </span>
        <span>•</span>
        <span class="flex items-center gap-1 font-bold text-amber-500">
          ⭐ <span>คะแนน: {data.rating.toFixed(1)} / 5</span>
        </span>
      </div>
    </header>

    <!-- Hero / Cover Image -->
    <div class="relative rounded-2xl overflow-hidden aspect-[16/9] mb-8 shadow-sm">
      <img
        src={data.coverImage}
        alt={data.title}
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Summary Box (ข้อมูลสำคัญ) -->
    <ShopSummaryBox
      shopName={data.shopName}
      rating={data.rating}
      openingHours={data.openingHours}
      priceRange={data.priceRange}
      googleMapsUrl={data.googleMapsUrl}
      recommendedMenus={data.recommendedMenus}
    />

    <!-- Article Content (Markdown) -->
    <div class="prose prose-stone lg:prose-lg max-w-none text-stone-700 leading-relaxed font-normal
      prose-headings:text-stone-900 prose-headings:font-bold
      prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline
      prose-blockquote:border-l-brand-500 prose-blockquote:bg-stone-50 prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:rounded-r-lg
      prose-img:rounded-xl">
      <Content />
    </div>

    <!-- Tags -->
    <div class="mt-12 pt-6 border-t border-stone-200">
      <h4 class="text-xs uppercase tracking-wider font-semibold text-stone-400 mb-3">แท็กที่เกี่ยวข้อง:</h4>
      <div class="flex flex-wrap gap-2">
        {data.tags.map((tag) => (
          <a
            href={`/category/${tag}`}
            class="text-xs font-medium bg-stone-100 hover:bg-stone-200 text-stone-700 px-3 py-1.5 rounded-lg transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    </div>

    <!-- Related Articles -->
    {relatedReviews.length > 0 && (
      <section class="mt-16 pt-10 border-t border-stone-200">
        <h3 class="text-xl font-bold text-stone-900 mb-6">
          ร้านใกล้เคียงหรือร้านที่คุณอาจสนใจ 🍜
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedReviews.map((item) => (
            <FoodCard review={item} />
          ))}
        </div>
      </section>
    )}
  </article>
</MainLayout>
