---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allReviews = await getCollection('reviews');

// Group categories
const categoryMap = new Map<string, number>();
allReviews.forEach(r => {
  categoryMap.set(r.data.category, (categoryMap.get(r.data.category) || 0) + 1);
});

// Group tags
const tagMap = new Map<string, number>();
allReviews.forEach(r => {
  r.data.tags.forEach(t => {
    tagMap.set(t, (tagMap.get(t) || 0) + 1);
  });
});
---

<MainLayout title="หมวดหมู่ร้านอาหารทั้งหมด ย่านอ่าวอุดม">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-50 dark:bg-stone-800 text-brand-600 dark:text-brand-400 text-xs font-bold mb-3 shadow-2xs">
        <span>🍜 หมวดหมู่อาหาร & คาเฟ่</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-stone-900 dark:text-white tracking-tight">
        หมวดหมู่และประเภทอาหาร
      </h1>
      <p class="text-stone-500 dark:text-stone-400 text-sm md:text-base mt-2">
        เลือกค้นหาร้านอาหารตามประเภทความอร่อย สไตล์อาหาร หรือเปิดวงล้อสุ่มเฉพาะหมวดหมู่นี้
      </p>

      <div class="mt-6 flex justify-center">
        <button
          type="button"
          data-open-wheel
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-gradient-to-r from-brand-600 to-amber-500 hover:from-brand-700 hover:to-amber-600 text-white font-bold text-xs sm:text-sm shadow-md transition-all cursor-pointer"
        >
          <span>🎲</span> สุ่มของกินจากหมวดหมู่นี้
        </button>
      </div>
    </div>

    <!-- Main Categories -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-stone-900 dark:text-white mb-6 flex items-center gap-2">
        <span>📂</span> หมวดหมู่หลัก
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {Array.from(categoryMap.entries()).map(([cat, count]) => (
          <a
            href={`/category/${cat}`}
            class="p-5 bg-white dark:bg-stone-900 rounded-2xl border border-stone-200 dark:border-stone-800 hover:border-brand-500 hover:shadow-md transition-all flex items-center justify-between group"
          >
            <span class="font-bold text-stone-800 dark:text-stone-200 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              {cat}
            </span>
            <span class="text-xs font-semibold bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 px-2.5 py-1 rounded-full group-hover:bg-brand-50 dark:group-hover:bg-stone-700 group-hover:text-brand-600 dark:group-hover:text-brand-400">
              {count} ร้าน
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Tags -->
    <div>
      <h2 class="text-xl font-bold text-stone-900 dark:text-white mb-6 flex items-center gap-2">
        <span>🏷️</span> แท็กทั้งหมด
      </h2>
      <div class="flex flex-wrap gap-2.5">
        {Array.from(tagMap.entries()).map(([tag, count]) => (
          <a
            href={`/category/${tag}`}
            class="inline-flex items-center gap-2 text-sm bg-stone-100 dark:bg-stone-800 hover:bg-stone-200 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-300 px-4 py-2 rounded-xl transition-colors"
          >
            <span>#{tag}</span>
            <span class="text-xs text-stone-400">({count})</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</MainLayout>
