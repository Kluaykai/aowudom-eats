---
import MainLayout from '../../layouts/MainLayout.astro';
import MotorbikeCard from '../../components/MotorbikeCard.astro';
import { getCollection } from 'astro:content';

const allBikes = await getCollection('motorbikes');
---

<MainLayout
  title="ร้านซ่อมมอเตอร์ไซค์ ปะยาง เปลี่ยนน้ำมันเครื่อง ย่านอ่าวอุดม ม.เกษตร ศรีราชา"
  description="รวมร้านซ่อมรถมอเตอร์ไซค์ ร้านปะยางด่วน บริการซ่อมนอกสถานที่ 24 ชม. ถ่ายน้ำมันเครื่อง ล้างชุดข้าง ย่านอ่าวอุดมและ ม.เกษตร ศรีราชา พร้อมเบอร์โทรติดต่อทันที"
>
  <div class="max-w-6xl mx-auto px-4 py-10 md:py-14">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-50 text-red-600 text-xs font-semibold mb-3">
        🛵 บริการซ่อมรถมอเตอร์ไซค์ & ปะยาง
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-stone-900 tracking-tight">
        ร้านซ่อมมอเตอร์ไซค์ <span class="text-red-600">ย่านอ่าวอุดม</span>
      </h1>
      <p class="mt-3 text-stone-600 text-sm md:text-base">
        รถยางรั่ว สตาร์ทไม่ติด สายพานขาด หรือต้องการถ่ายน้ำมันเครื่อง รวบรวมร้านซ่อมและเบอร์ช่างฉุกเฉินนอกสถานที่รอบ ม.เกษตร ศรีราชา
      </p>
    </div>

    <!-- Emergency notice banner -->
    <div class="bg-red-500 text-white rounded-2xl p-4 md:p-6 mb-10 shadow-sm flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3 text-center md:text-left">
        <span class="text-3xl">🚨</span>
        <div>
          <h2 class="font-bold text-base md:text-lg">เหตุฉุกเฉิน ยางแบน รถดับกลางดึก?</h2>
          <p class="text-red-100 text-xs md:text-sm">มีบริการช่างปะยางและซ่อมนอกสถานที่ 24 ชั่วโมง พร้อมออกไปช่วยเหลือถึงหน้าหอพัก</p>
        </div>
      </div>
      <a
        href="tel:0933242443"
        class="bg-white text-red-600 hover:bg-red-50 font-extrabold text-sm px-6 py-3 rounded-xl shadow-md transition-all shrink-0 flex items-center gap-2"
      >
        <span>📞</span> โทรช่างด่วน 24 ชม.
      </a>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allBikes.map((bike) => (
        <MotorbikeCard bike={bike} />
      ))}
    </div>
  </div>
</MainLayout>
