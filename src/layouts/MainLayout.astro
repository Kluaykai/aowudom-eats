---
interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  schema?: Record<string, any>;
  exactTitle?: boolean;
}

const {
  title,
  description = "รวมรีวิวร้านอาหาร ของกินอ่าวอุดม ม.เกษตร ศรีราชา ร้านเด็ดรอบรั้วมหาวิทยาลัยและร้านปิดดึกสำหรับเด็กหอ",
  image = "/images/og-default.jpg",
  article = false,
  schema,
  exactTitle = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = "SRC News";
const pageTitle = exactTitle ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="th" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Structured Data (JSON-LD) for Google Rich Results -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Google Font Prompt -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style is:global>
      body {
        font-family: 'Prompt', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }
    </style>
  </head>
  <body class="bg-[#fafaf9] text-stone-800 flex flex-col min-h-screen antialiased selection:bg-brand-500 selection:text-white">
    <!-- Header -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-stone-200">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <span class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 to-orange-400 flex items-center justify-center text-white font-bold text-xl shadow-sm group-hover:scale-105 transition-transform">
            🍽️
          </span>
          <div class="flex flex-col">
            <span class="font-bold text-lg text-stone-900 leading-tight tracking-tight">อ่าวอุดม<span class="text-brand-500">Food</span></span>
            <span class="text-[11px] text-stone-500 tracking-wider">KU SRIRACHA FOOD GUIDE</span>
          </div>
        </a>

        <!-- Navigation Links -->
        <nav class="hidden md:flex items-center gap-5 text-sm font-medium text-stone-600">
          <a href="/" class="hover:text-brand-600 transition-colors">หน้าแรก</a>
          <a href="/dorms" class="hover:text-blue-600 transition-colors flex items-center gap-1">🏢 หอพัก/คอนโด</a>
          <a href="/nightlife" class="hover:text-purple-600 transition-colors flex items-center gap-1">🍻 ร้านเหล้า</a>
          <a href="/motorbikes" class="hover:text-red-600 transition-colors flex items-center gap-1">🛵 ซ่อมมอไซค์</a>
          <a href="/categories" class="hover:text-brand-600 transition-colors">ร้านอาหารทั้งหมด</a>
        </nav>

        <div class="flex items-center gap-2">
          <a href="/motorbikes" class="text-xs md:text-sm font-semibold bg-red-50 hover:bg-red-100 text-red-700 px-3 py-1.5 rounded-full transition-colors flex items-center gap-1">
            🛵 ซ่อมรถด่วน
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-stone-200 py-10 mt-16 text-stone-600 text-sm">
      <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="font-bold text-base text-stone-900">อ่าวอุดม<span class="text-brand-500">Food</span> Guide</span>
          </div>
          <p class="text-xs text-stone-500">รวมพิกัดของอร่อย ม.เกษตร ศรีราชา และย่านอ่าวอุดม เพื่อสายกินและเด็กหอทุกคน</p>
        </div>

        <div class="flex flex-wrap gap-4 text-xs font-medium text-stone-500">
          <a href="/" class="hover:text-brand-600">หน้าแรก</a>
          <a href="/sitemap-index.xml" class="hover:text-brand-600">Sitemap</a>
          <a href="/robots.txt" class="hover:text-brand-600">Robots.txt</a>
        </div>

        <p class="text-xs text-stone-400">
          &copy; {new Date().getFullYear()} AuwAudom Food Guide. Crafted with Astro & Tailwind.
        </p>
      </div>
    </footer>
  </body>
</html>
